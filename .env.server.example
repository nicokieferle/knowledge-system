# Replace this URL-safe example password in both values before first start.
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=knowledge
DATABASE_URL=postgresql://knowledge:replace-with-a-long-random-password@postgres:5432/knowledge

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

MCP_PATH=/mcp
MCP_ALLOWED_HOSTS=127.0.0.1:8000,localhost:8000
MCP_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Use a separate bot token from the Journaling project. Never commit real values.
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-5-mini
LLM_API_KEY=replace-with-provider-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
TELEGRAM_BOT_TOKEN=replace-with-knowledge-system-bot-token
