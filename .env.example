# Local development example. Use .env.server.example for Debian Docker deployment.
DATABASE_URL=postgresql://knowledge:knowledge@localhost:5432/knowledge
KNOWLEDGE_ROOT=./knowledge
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
# Only needed when starting knowledge-mcp with MCP_TRANSPORT=streamable-http.
# Generate a separate random token of at least 32 ASCII characters locally.
MCP_HTTP_CLIENT_ID=external-read
MCP_HTTP_BEARER_TOKEN=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-5-mini
LLM_API_KEY=replace-me
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
TELEGRAM_BOT_TOKEN=replace-me-with-a-dedicated-token

# Separater privater Proposal-Eingang: vollständiger Vertrag in docs/proposal-ingress.md.
# Pflichtwerte privat setzen; Owner muss mit REVIEW_OWNER_* übereinstimmen.
PROPOSAL_INGRESS_CLIENT_ID=
PROPOSAL_INGRESS_BEARER_TOKEN=
PROPOSAL_INGRESS_OWNER_CLIENT_TYPE=
PROPOSAL_INGRESS_OWNER_CHAT_ID=
PROPOSAL_INGRESS_OWNER_USER_ID=
PROPOSAL_INGRESS_HOST=127.0.0.1
PROPOSAL_INGRESS_PORT=8081
PROPOSAL_INGRESS_ALLOWED_HOSTS=127.0.0.1:8081,localhost:8081
